rules_version = '2';

// Firestore-Sicherheitsregeln für G!RP
// Stand: identisch mit der Firebase-Konsole (veröffentlicht am 21.07.2025).
// Änderungen hier ersetzen NICHT automatisch die Regeln in der Konsole –
// bitte dort einfügen und veröffentlichen (oder per `firebase deploy --only firestore:rules`).

service cloud.firestore {
  match /databases/{db}/documents {
    match /{document=**} {
      // Jeder darf lesen (Ranglisten sind öffentlich)
      allow read: if true;

      // Schreiben ausschließlich für den Admin-Account
      allow write: if request.auth != null
                   && request.auth.uid in ["GnxwSTg7ijU5y7AGYGPG9Yz1bzU2"];
    }
  }
}
